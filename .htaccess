# Web root shim for shared hosting where the document root cannot point at public/.
# This file sits in the document root (the application root) and serves the app
# from public/ without a /public prefix in URLs.
#
# Order matters: 1. HTTPS redirect  2. block /public/ and deny list  3. rewrite to public/
# Security headers (mod_headers) are set at the end of the file, independent of the rewrite rules.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. HTTP -> HTTPS (301) for everything except:
    #    - /iclock/... : the attendance machine can only speak plain HTTP. Matched on
    #      THE_REQUEST (the original request line), which no internal rewrite changes,
    #      unlike REQUEST_URI whose value after rewrites differs between servers;
    #    - local development hosts (localhost, 127.0.0.1, [::1], *.test).
    #    Lives here (not in public/.htaccess) because this is the first file
    #    Apache reads for every request, and the only one that exists whichever
    #    way the app is served; public/.htaccess stays the stock Laravel file.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{THE_REQUEST} !^[A-Z]+\s+(?:https?://[^/\s]+)?/iclock(?:[/?\s]|$)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !\.test(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} ^([^:]+)
    RewriteRule ^ https://%1%{REQUEST_URI} [QSA,L,R=301]

    # 2a. The internal public/ prefix is not a URL: a direct request for /public/... would serve a
    #     second copy of the app, so it is a plain 404. Decided on THE_REQUEST (the original request
    #     line), which no internal rewrite changes, so the rewrite to public/ in step 3 still works.
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s+(?:https?://[^/\s]+)?/public(?:[/?\s]|$) [NC]
    RewriteRule ^ - [R=404,L]

    # 2. Deny everything that is not meant to be served (403), even though the
    #    rewrite below would also hide it: dotfiles (.env, .git, .htaccess ...,
    #    but not /.well-known/), application directories, and root files.
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
    RewriteRule ^(?:storage|vendor|bootstrap|config|database|routes|app|resources|tests|deploy|scripts|docs|node_modules)(?:/|$) - [F,L]
    RewriteRule ^(?:artisan|composer\.[^/]*|package(?:-lock)?\.json|phpunit\.xml|[^/]*\.md)$ - [F,L]

    # Trailing slash: redirect here (308) instead of letting public/.htaccess do it,
    # whose redirect would expose the internal /public prefix.
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^(?!public/).+/$ %1 [L,R=308]

    # 3. Everything else is served from public/ (static files and index.php).
    #    The (?!public/) guard stops the internal redirect from looping.
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

# Fallback if mod_rewrite is unavailable: never serve these root files.
<FilesMatch "^(\.(?!well-known)[^/]*|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|env\.seed|env\.production\.example|status\.(txt|log)|release\.(txt|manifest)|cron\.sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers for everything the app serves. Guarded so a host without mod_headers cannot 500.
# No script/style Content-Security-Policy on purpose (the app uses inline styles for the accent
# colour); only frame-ancestors, which is the framing half of X-Frame-Options.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "frame-ancestors 'none'"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS only on HTTPS responses (env=HTTPS is unset on plain HTTP, so /iclock, which the
    # attendance machine calls over plain HTTP, never gets it).
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>
