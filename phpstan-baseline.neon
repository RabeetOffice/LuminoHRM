			path: app/Console/Commands/BackupDatabase.php

		-
			message: '#^Property App\\Console\\Commands\\BackupDatabase\:\:\$cursor \(PDOStatement\|null\) does not accept PDOStatement\|false\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Console/Commands/BackupDatabase.php

		-
			message: '#^Property App\\Console\\Commands\\BackupDatabase\:\:\$gz \(resource\|null\) does not accept resource\|false\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Console/Commands/BackupDatabase.php

		-
			message: '#^Method App\\Http\\Controllers\\AuditLogController\:\:userOptions\(\) should return list\<array\{id\: int, name\: string\}\> but returns array\<int, array\{id\: int, name\: string\}\>\.$#'
			identifier: return.type
			count: 1
			path: app/Http/Controllers/AuditLogController.php

		-
			message: '#^Method App\\Http\\Controllers\\DepartmentController\:\:whereNameLike\(\) has parameter \$query with generic class Illuminate\\Database\\Eloquent\\Builder but does not specify its types\: TModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Http/Controllers/DepartmentController.php

		-
			message: '#^Method App\\Http\\Controllers\\DepartmentController\:\:whereNameLike\(\) return type with generic class Illuminate\\Database\\Eloquent\\Builder does not specify its types\: TModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Http/Controllers/DepartmentController.php

		-
			message: '#^Parameter \#1 \$sql of method Illuminate\\Database\\Eloquent\\Builder\<Illuminate\\Database\\Eloquent\\Model\>\:\:whereRaw\(\) expects Illuminate\\Contracts\\Database\\Query\\Expression\|literal\-string, non\-falsy\-string given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/DepartmentController.php

		-
			message: '#^Parameter \#5 \$map of method App\\Http\\Controllers\\DepartmentController\:\:page\(\) expects callable\(Illuminate\\Database\\Eloquent\\Model\)\: array\<string, mixed\>, Closure\(App\\Models\\Department\)\: array\{id\: int, name\: string, designations_count\: int\<0, max\>, created_at\: string\|null\} given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/DepartmentController.php

		-
			message: '#^Method App\\Http\\Controllers\\Settings\\HrmSettingsController\:\:allowedGroups\(\) should return list\<string\> but returns list\<int\|string\>\.$#'
			identifier: return.type
			count: 1
			path: app/Http/Controllers/Settings/HrmSettingsController.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(int\|string\)\: bool\)\|null, Closure\(string\)\: bool given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/Settings/HrmSettingsController.php

