			count: 3
			path: app/Console/Commands/BackupDatabase.php

		-
			message: '#^Cannot call method setFetchMode\(\) on PDOStatement\|false\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Console/Commands/BackupDatabase.php

		-
			message: '#^Method App\\Console\\Commands\\BackupDatabase\:\:tables\(\) should return list\<string\> but returns array\<string\>\.$#'
			identifier: return.type
			count: 1
			path: app/Console/Commands/BackupDatabase.php

		-
			message: '#^Method App\\Console\\Commands\\BackupDatabase\:\:tryFlock\(\) has parameter \$wouldBlock with no type specified\.$#'
